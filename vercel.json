{
  "cleanUrls": true,
  "installCommand": "npm --prefix frontend/frontend ci --ignore-scripts",
  "buildCommand": "npm --prefix frontend/frontend run build",
  "outputDirectory": "frontend/frontend/dist",
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/ai-studio", "destination": "/ai-studio.html" },
    { "source": "/cutter", "destination": "/cutter.html" },
    { "source": "/artwork", "destination": "/artwork.html" },
    { "source": "/validation", "destination": "/validation.html" },
    { "source": "/account", "destination": "/account.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" }
      ]
    }
  ]
}
